# Data (never committed; may be proprietary/large)
data/*/*
!data/*/.gitkeep
# Model weights / artefacts
models/
*.pt
*.pth
*.ckpt
*.onnx
*.safetensors
# Python
__pycache__/
*.pyc
.venv/
venv/
.ipynb_checkpoints/
.pytest_cache/
*.egg-info/
# OS / editor
.DS_Store
Thumbs.db
.vscode/

# Step 2 outputs
runs/
*.log
*.joblib

# Artifacts: only the deployable unit is versioned (model.onnx + model_meta.json, which belong together).
# best.pt, norm_stats.json, threshold.json, model_config.json and the INT8 experiments are regenerated
# by `python tasks.py all` (training) and are not needed to serve the model.
artifacts/*
!artifacts/model.onnx
!artifacts/model_meta.json
.venv*/
